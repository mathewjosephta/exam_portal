# Environment variables and secrets
.env
.env.*
!.env.example

# Local database and mail configuration
/config/database.php
/config/mail.php

# Dependencies
/vendor/
/node_modules/

# Logs
*.log
logs/
error_log

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE settings
.vscode/
.idea/

# Local backups and database dumps
*.bak
*.backup
*.sql.gz
*.dump

# PHP debugging and runtime files
*.cache
.phpunit.cache/
.phpunit.result.cache

# Local database files
*.sqlite
*.sqlite3
*.db

# Build and generated files
/dist/
/build/

# Local configuration overrides
config.local.php
config.dev.php

# Uploaded files and generated reports
/uploads/*
!/uploads/.gitkeep
/reports/*
!/reports/.gitkeep

# Session files
/sessions/

# Coverage reports
/coverage/

